    <bpmn:userTask id="u1" name="Corrigir o registro apontado em Meus registros"><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_14</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_15</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="gU" name="UUID já recebido?"><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_9</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_16</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t6" name="Confirmar sem duplicar (idempotente)"><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_16</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_18</bpmn:outgoing></bpmn:serviceTask>
