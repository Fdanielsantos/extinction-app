    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Registro sem conexão ou com falha no envio"><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="gm0" name=""><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_0</bpmn:incoming><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_5</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_1</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g0" name="Fila com menos de 100 registros?"><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_1</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_2</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t0" name="Avisar &quot;fila cheia&quot; e manter o formulário aberto"><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_3</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="ev0" name="Espaço liberado na fila"><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_4</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_5</bpmn:outgoing><bpmn:conditionalEventDefinition><bpmn:condition xsi:type="bpmn:tFormalExpression"/></bpmn:conditionalEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="t1" name="Copiar as fotos e gravar o registro na fila (UUID)"><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_2</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t2" name="Mostrar &quot;Pendente de sincronização&quot; em Meus registros"><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_6</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_7</bpmn:outgoing></bpmn:serviceTask>
