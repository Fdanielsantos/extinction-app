  <bpmn:process id="Process_ASIS_01B_Identificacao_Especie" name="AS-IS 01.B — Identificar a espécie" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ASIS_01B_Identificacao_Especie">
      <bpmn:lane id="Lane_ASIS_01B_Identificacao_Especie_U" name="Usuário (cidadão)"><bpmn:flowNodeRef>ug</bpmn:flowNodeRef><bpmn:flowNodeRef>u5</bpmn:flowNodeRef><bpmn:flowNodeRef>lkv</bpmn:flowNodeRef><bpmn:flowNodeRef>u1</bpmn:flowNodeRef><bpmn:flowNodeRef>u2</bpmn:flowNodeRef><bpmn:flowNodeRef>um</bpmn:flowNodeRef><bpmn:flowNodeRef>u3</bpmn:flowNodeRef><bpmn:flowNodeRef>lk2</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_ASIS_01B_Identificacao_Especie_A" name="Aplicativo Extinction"><bpmn:flowNodeRef>lk</bpmn:flowNodeRef><bpmn:flowNodeRef>a1</bpmn:flowNodeRef><bpmn:flowNodeRef>be</bpmn:flowNodeRef><bpmn:flowNodeRef>ae</bpmn:flowNodeRef><bpmn:flowNodeRef>ag</bpmn:flowNodeRef><bpmn:flowNodeRef>a2</bpmn:flowNodeRef><bpmn:flowNodeRef>a3</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_ASIS_01B_Identificacao_Especie_B" name="Backend (API)"><bpmn:flowNodeRef>b1</bpmn:flowNodeRef><bpmn:flowNodeRef>b2</bpmn:flowNodeRef><bpmn:flowNodeRef>b3</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_ASIS_01B_Identificacao_Especie_I" name="Serviço de IA (BioCLIP)"><bpmn:flowNodeRef>i1</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="lk" name="Vindo de 01.A (fotos e local definidos)"><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_0</bpmn:outgoing><bpmn:linkEventDefinition name="Vindo de 01.A (fotos e local definidos)"/></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="a1" name="Enviar a 1ª foto para identificação"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_0</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_1</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:boundaryEvent id="be" name="Falha de rede ou do servidor" attachedToRef="a1"><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_6</bpmn:outgoing><bpmn:errorEventDefinition/></bpmn:boundaryEvent>
    <bpmn:serviceTask id="ae" name="Exibir &quot;Falha ao identificar espécie&quot;"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_6</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ug" name="Tentar identificar de novo?"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_7</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_8</bpmn:outgoing><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="u5" name="Remover a 1ª foto e adicioná-la de novo"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_8</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_9</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateThrowEvent id="lkv" name="Voltar para 01.A"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_9</bpmn:incoming><bpmn:linkEventDefinition name="Captura"/></bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="b1" name="Receber a foto e solicitar a inferência"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_1</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="i1" name="Inferir as 5 espécies mais prováveis"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_2</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="b2" name="Descartar candidatas abaixo de 20% de confiança"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_3</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="b3" name="Criar no catálogo as espécies ausentes (status NE)"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_4</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ag" name="Há candidatas?"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_5</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_11</bpmn:outgoing><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a2" name="Listar candidatas e pré-selecionar a de maior confiança"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_11</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="a3" name="Exibir &quot;Espécie não identificada&quot; com campo de sugestão"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_10</bpmn:incoming><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_12</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="u1" name="Manter ou trocar a espécie pré-selecionada"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_13</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_15</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="u2" name="Digitar uma sugestão de espécie (texto livre)"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_14</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01B_Identificacao_Especie_16</bpmn:outgoing></bpmn:userTask>
