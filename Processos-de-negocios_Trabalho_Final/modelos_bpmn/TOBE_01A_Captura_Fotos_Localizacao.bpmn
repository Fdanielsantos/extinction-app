    <bpmn:userTask id="cam2" name="Fotografar e ajustar o recorte"><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_9</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_12</bpmn:outgoing></bpmn:userTask>
