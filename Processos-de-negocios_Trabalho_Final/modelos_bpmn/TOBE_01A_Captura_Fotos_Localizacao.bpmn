    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Decide registrar um avistamento"><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="t1" name="Abrir a tela &quot;Novo avistamento&quot;"><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_0</bpmn:incoming><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_10</bpmn:incoming><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_13</bpmn:incoming><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_14</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_1</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Origem da foto?"><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_1</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_2</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="gal1" name="Solicitar permissão de acesso à galeria"><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_3</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gg1" name="Permissão concedida?"><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_4</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_6</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="gal2" name="Selecionar de 1 a 6 fotos"><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_8</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_11</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="gg2" name="Seleção confirmada e fotos JPG/PNG?"><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_11</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_13</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_15</bpmn:outgoing></bpmn:exclusiveGateway>
