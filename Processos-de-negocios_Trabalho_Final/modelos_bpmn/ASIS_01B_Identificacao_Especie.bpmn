    <bpmn:intermediateThrowEvent id="lk2" name="Ir para 01.C (publicação)"><bpmn:incoming>Flow_ASIS_01B_Identificacao_Especie_18</bpmn:incoming><bpmn:linkEventDefinition name="Publicacao"/></bpmn:intermediateThrowEvent>
