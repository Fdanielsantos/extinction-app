    <bpmn:exclusiveGateway id="gE" name="Erro temporário (rede ou servidor)?"><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_10</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_11</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t4" name="Calcular o novo intervalo (backoff exponencial)"><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_11</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_12</bpmn:outgoing></bpmn:serviceTask>
