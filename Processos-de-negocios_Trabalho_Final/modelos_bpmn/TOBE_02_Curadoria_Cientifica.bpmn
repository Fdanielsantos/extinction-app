      <bpmn:lane id="Lane_TOBE_02_Curadoria_Cientifica_C" name="Curador do catálogo"><bpmn:flowNodeRef>d_t10</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="d_s" name="Nova pendência na fila"><bpmn:outgoing>Flow_TOBE_02_Curadoria_Cientifica_0</bpmn:outgoing><bpmn:messageEventDefinition/></bpmn:startEvent>
