    <bpmn:sequenceFlow id="Flow_ASIS_01C_Publicacao_13" name="Não (erro 400)" sourceRef="bg" targetRef="a5"/>
    <bpmn:sequenceFlow id="Flow_ASIS_01C_Publicacao_14" sourceRef="a5" targetRef="u2"/>
    <bpmn:sequenceFlow id="Flow_ASIS_01C_Publicacao_15" name="Tocar &quot;Publicar&quot; novamente" sourceRef="u2" targetRef="u1"/>
    <bpmn:sequenceFlow id="Flow_ASIS_01C_Publicacao_16" name="Sim" sourceRef="bg" targetRef="b2"/>
    <bpmn:sequenceFlow id="Flow_ASIS_01C_Publicacao_17" sourceRef="b2" targetRef="b3"/>
    <bpmn:sequenceFlow id="Flow_ASIS_01C_Publicacao_18" sourceRef="b3" targetRef="a4"/>
    <bpmn:sequenceFlow id="Flow_ASIS_01C_Publicacao_19" sourceRef="a4" targetRef="e"/>
  </bpmn:process>
