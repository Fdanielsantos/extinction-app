    <bpmn:serviceTask id="d_t12" name="Redistribuir a outros especialistas"><bpmn:incoming>Flow_TOBE_02_Curadoria_Cientifica_4</bpmn:incoming><bpmn:outgoing>Flow_TOBE_02_Curadoria_Cientifica_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="d_g1" name="Parecer"><bpmn:incoming>Flow_TOBE_02_Curadoria_Cientifica_3</bpmn:incoming><bpmn:outgoing>Flow_TOBE_02_Curadoria_Cientifica_6</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_02_Curadoria_Cientifica_7</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_02_Curadoria_Cientifica_8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="d_t4" name="Aplicar o selo de Validação Científica"><bpmn:incoming>Flow_TOBE_02_Curadoria_Cientifica_6</bpmn:incoming><bpmn:outgoing>Flow_TOBE_02_Curadoria_Cientifica_12</bpmn:outgoing></bpmn:serviceTask>
