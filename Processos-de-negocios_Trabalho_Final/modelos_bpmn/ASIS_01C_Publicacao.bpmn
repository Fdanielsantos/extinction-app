  <bpmn:collaboration id="Collab_ASIS_01C_Publicacao"><bpmn:participant id="Pool_ASIS_01C_Publicacao" name="Extinction — Registrar avistamento (AS-IS) — Parte C: publicação" processRef="Process_ASIS_01C_Publicacao"/></bpmn:collaboration>
  <bpmn:process id="Process_ASIS_01C_Publicacao" name="AS-IS 01.C — Publicar a postagem" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ASIS_01C_Publicacao">
      <bpmn:lane id="Lane_ASIS_01C_Publicacao_U" name="Usuário (cidadão)"><bpmn:flowNodeRef>lk</bpmn:flowNodeRef><bpmn:flowNodeRef>u1</bpmn:flowNodeRef><bpmn:flowNodeRef>u2</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_ASIS_01C_Publicacao_A" name="Aplicativo Extinction"><bpmn:flowNodeRef>ag1</bpmn:flowNodeRef><bpmn:flowNodeRef>a1</bpmn:flowNodeRef><bpmn:flowNodeRef>ag2</bpmn:flowNodeRef><bpmn:flowNodeRef>a2</bpmn:flowNodeRef><bpmn:flowNodeRef>be2</bpmn:flowNodeRef><bpmn:flowNodeRef>gm1</bpmn:flowNodeRef><bpmn:flowNodeRef>a3</bpmn:flowNodeRef><bpmn:flowNodeRef>be3</bpmn:flowNodeRef><bpmn:flowNodeRef>a5</bpmn:flowNodeRef><bpmn:flowNodeRef>a4</bpmn:flowNodeRef><bpmn:flowNodeRef>e</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_ASIS_01C_Publicacao_B" name="Backend (API)"><bpmn:flowNodeRef>b1</bpmn:flowNodeRef><bpmn:flowNodeRef>bg</bpmn:flowNodeRef><bpmn:flowNodeRef>b2</bpmn:flowNodeRef><bpmn:flowNodeRef>b3</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="lk" name="Vindo de 01.B"><bpmn:outgoing>Flow_ASIS_01C_Publicacao_0</bpmn:outgoing><bpmn:linkEventDefinition name="Vindo de 01.B"/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="u1" name="Tocar &quot;Publicar avistamento&quot;"><bpmn:incoming>Flow_ASIS_01C_Publicacao_0</bpmn:incoming><bpmn:incoming>Flow_ASIS_01C_Publicacao_3</bpmn:incoming><bpmn:incoming>Flow_ASIS_01C_Publicacao_15</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01C_Publicacao_1</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ag1" name="Há foto e espécie (ou sugestão)?"><bpmn:incoming>Flow_ASIS_01C_Publicacao_1</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01C_Publicacao_2</bpmn:outgoing><bpmn:outgoing>Flow_ASIS_01C_Publicacao_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a1" name="Exibir aviso do dado que falta"><bpmn:incoming>Flow_ASIS_01C_Publicacao_2</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01C_Publicacao_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ag2" name="Há localização?"><bpmn:incoming>Flow_ASIS_01C_Publicacao_4</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01C_Publicacao_5</bpmn:outgoing><bpmn:outgoing>Flow_ASIS_01C_Publicacao_6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a2" name="Obter cidade e UF pelas coordenadas"><bpmn:incoming>Flow_ASIS_01C_Publicacao_5</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01C_Publicacao_7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:boundaryEvent id="be2" name="" attachedToRef="a2"><bpmn:outgoing>Flow_ASIS_01C_Publicacao_8</bpmn:outgoing><bpmn:errorEventDefinition/></bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="gm1" name=""><bpmn:incoming>Flow_ASIS_01C_Publicacao_6</bpmn:incoming><bpmn:incoming>Flow_ASIS_01C_Publicacao_7</bpmn:incoming><bpmn:incoming>Flow_ASIS_01C_Publicacao_8</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01C_Publicacao_9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a3" name="Enviar fotos, espécie ou sugestão, legenda e local (se houver)"><bpmn:incoming>Flow_ASIS_01C_Publicacao_9</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01C_Publicacao_10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:boundaryEvent id="be3" name="Sem conexão, tempo esgotado ou sessão expirada" attachedToRef="a3"><bpmn:outgoing>Flow_ASIS_01C_Publicacao_12</bpmn:outgoing><bpmn:errorEventDefinition/></bpmn:boundaryEvent>
    <bpmn:serviceTask id="a5" name="Exibir &quot;Não foi possível publicar&quot; mantendo os dados"><bpmn:incoming>Flow_ASIS_01C_Publicacao_12</bpmn:incoming><bpmn:incoming>Flow_ASIS_01C_Publicacao_13</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01C_Publicacao_14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="u2" name="Verificar conexão, entrar de novo ou corrigir os dados"><bpmn:incoming>Flow_ASIS_01C_Publicacao_14</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01C_Publicacao_15</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="b1" name="Validar fotos e espécie ou sugestão (até 150 caracteres)"><bpmn:incoming>Flow_ASIS_01C_Publicacao_10</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01C_Publicacao_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="bg" name="Dados válidos?"><bpmn:incoming>Flow_ASIS_01C_Publicacao_11</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01C_Publicacao_13</bpmn:outgoing><bpmn:outgoing>Flow_ASIS_01C_Publicacao_16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="b2" name="Gravar as fotos no servidor"><bpmn:incoming>Flow_ASIS_01C_Publicacao_16</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01C_Publicacao_17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="b3" name="Gravar a postagem (localidade só se informada)"><bpmn:incoming>Flow_ASIS_01C_Publicacao_17</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01C_Publicacao_18</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="a4" name="Exibir &quot;Publicado!&quot; e limpar o formulário"><bpmn:incoming>Flow_ASIS_01C_Publicacao_18</bpmn:incoming><bpmn:outgoing>Flow_ASIS_01C_Publicacao_19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Avistamento no feed (e no mapa, se tiver local)"><bpmn:incoming>Flow_ASIS_01C_Publicacao_19</bpmn:incoming></bpmn:endEvent>
