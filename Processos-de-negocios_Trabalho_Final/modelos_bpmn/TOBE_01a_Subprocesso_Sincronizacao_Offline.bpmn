    <bpmn:serviceTask id="t3" name="Enviar o próximo item (ordem FIFO)"><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_8</bpmn:incoming><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_13</bpmn:incoming><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_15</bpmn:incoming><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_23</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_9</bpmn:outgoing></bpmn:serviceTask>
