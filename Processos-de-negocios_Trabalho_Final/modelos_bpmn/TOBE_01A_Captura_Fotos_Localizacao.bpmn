    <bpmn:userTask id="gal4" name="Conferir ou ajustar o pino"><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_16</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_17</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="gg3" name="Informar o local?"><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_17</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_18</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="gal5" name="Registrar as coordenadas do pino"><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_18</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_20</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="cam1" name="Solicitar permissão de uso da câmera"><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_2</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_5</bpmn:outgoing></bpmn:serviceTask>
