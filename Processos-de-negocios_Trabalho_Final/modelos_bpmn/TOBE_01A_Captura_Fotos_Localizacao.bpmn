    <bpmn:serviceTask id="cam4" name="Obter a posição atual pelo GPS"><bpmn:incoming>Flow_TOBE_01A_Captura_Fotos_Localizacao_23</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01A_Captura_Fotos_Localizacao_25</bpmn:outgoing></bpmn:serviceTask>
