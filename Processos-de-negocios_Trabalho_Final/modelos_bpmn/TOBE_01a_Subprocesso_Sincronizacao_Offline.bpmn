    <bpmn:serviceTask id="t8" name="Remover o item da fila"><bpmn:incoming>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_20</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01a_Subprocesso_Sincronizacao_Offline_21</bpmn:outgoing></bpmn:serviceTask>
