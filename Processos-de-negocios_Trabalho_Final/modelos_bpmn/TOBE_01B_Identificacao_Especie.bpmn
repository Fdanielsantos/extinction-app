  <bpmn:process id="Process_TOBE_01B_Identificacao_Especie" name="TO-BE 01.B — Identificar a espécie" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TOBE_01B_Identificacao_Especie">
      <bpmn:lane id="Lane_TOBE_01B_Identificacao_Especie_U" name="Usuário (cidadão)"><bpmn:flowNodeRef>u1</bpmn:flowNodeRef><bpmn:flowNodeRef>ug</bpmn:flowNodeRef><bpmn:flowNodeRef>u2</bpmn:flowNodeRef><bpmn:flowNodeRef>um</bpmn:flowNodeRef><bpmn:flowNodeRef>u3</bpmn:flowNodeRef><bpmn:flowNodeRef>lk2</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_TOBE_01B_Identificacao_Especie_A" name="Aplicativo Extinction"><bpmn:flowNodeRef>lk</bpmn:flowNodeRef><bpmn:flowNodeRef>ag0</bpmn:flowNodeRef><bpmn:flowNodeRef>a1</bpmn:flowNodeRef><bpmn:flowNodeRef>be</bpmn:flowNodeRef><bpmn:flowNodeRef>tg</bpmn:flowNodeRef><bpmn:flowNodeRef>tt</bpmn:flowNodeRef><bpmn:flowNodeRef>a0</bpmn:flowNodeRef><bpmn:flowNodeRef>ag</bpmn:flowNodeRef><bpmn:flowNodeRef>a2</bpmn:flowNodeRef><bpmn:flowNodeRef>a3</bpmn:flowNodeRef><bpmn:flowNodeRef>lkv</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_TOBE_01B_Identificacao_Especie_B" name="Backend (API)"><bpmn:flowNodeRef>b1</bpmn:flowNodeRef><bpmn:flowNodeRef>b2</bpmn:flowNodeRef><bpmn:flowNodeRef>b3</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_TOBE_01B_Identificacao_Especie_I" name="Serviço de IA (BioCLIP)"><bpmn:flowNodeRef>i1</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="lk" name="Vindo de 01.A (fotos e local definidos)"><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_0</bpmn:outgoing><bpmn:linkEventDefinition name="Vindo de 01.A (fotos e local definidos)"/></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="ag0" name="Há conexão?"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_0</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_1</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_2</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a1" name="Enviar a 1ª foto para identificação"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_1</bpmn:incoming><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_6</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:boundaryEvent id="be" name="Falha ou tempo esgotado" attachedToRef="a1"><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_4</bpmn:outgoing><bpmn:errorEventDefinition/></bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="tg" name="Menos de 3 tentativas?"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_4</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_5</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="tt" name="Aguardar alguns segundos"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_5</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_6</bpmn:outgoing><bpmn:timerEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="a0" name="Informar: a identificação será feita após o envio"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_2</bpmn:incoming><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_7</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="b1" name="Receber a foto e solicitar a inferência"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_3</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="i1" name="Inferir as 5 espécies mais prováveis"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_9</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="b2" name="Descartar candidatas abaixo do limiar (20%)"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_10</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="b3" name="Criar espécie ausente (NE) com tarefa de curadoria"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_11</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ag" name="Há candidatas?"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_12</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_13</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a2" name="Mostrar as candidatas com foto de referência e status"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_13</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="a3" name="Exibir dicas para nova foto (luz, distância, enquadramento)"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_14</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_16</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="u1" name="Confirmar a pré-selecionada ou trocar, comparando as referências"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_15</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_19</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ug" name="Tirar nova foto?"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_16</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_17</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="lkv" name="Voltar para 01.A (nova foto)"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_17</bpmn:incoming><bpmn:linkEventDefinition name="Captura"/></bpmn:intermediateThrowEvent>
    <bpmn:userTask id="u2" name="Buscar a espécie no catálogo e sugerir (opcional)"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_18</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_20</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="um" name=""><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_8</bpmn:incoming><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_19</bpmn:incoming><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_20</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="u3" name="Complementar fotos (até 6) e legenda (opcional)"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_21</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01B_Identificacao_Especie_22</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateThrowEvent id="lk2" name="Ir para 01.C (publicação)"><bpmn:incoming>Flow_TOBE_01B_Identificacao_Especie_22</bpmn:incoming><bpmn:linkEventDefinition name="Publicacao"/></bpmn:intermediateThrowEvent>
