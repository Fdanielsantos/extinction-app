<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ASIS_02_Validacao_Identificacao" targetNamespace="http://extinction/bpmn" exporter="Extinction BPMN" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_ASIS_02_Validacao_Identificacao"><bpmn:participant id="Pool_ASIS_02_Validacao_Identificacao" name="Extinction — Validação de identificação (AS-IS)" processRef="Process_ASIS_02_Validacao_Identificacao"/></bpmn:collaboration>
  <bpmn:process id="Process_ASIS_02_Validacao_Identificacao" name="AS-IS 02 — Validar identificação de espécie" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ASIS_02_Validacao_Identificacao">
      <bpmn:lane id="Lane_ASIS_02_Validacao_Identificacao_E" name="Especialista (biólogo)"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>e1</bpmn:flowNodeRef><bpmn:flowNodeRef>e2</bpmn:flowNodeRef><bpmn:flowNodeRef>eg</bpmn:flowNodeRef><bpmn:flowNodeRef>eend</bpmn:flowNodeRef><bpmn:flowNodeRef>e3</bpmn:flowNodeRef><bpmn:flowNodeRef>e4</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_ASIS_02_Validacao_Identificacao_S" name="Aplicativo / Backend"><bpmn:flowNodeRef>s1</bpmn:flowNodeRef><bpmn:flowNodeRef>bs1</bpmn:flowNodeRef><bpmn:flowNodeRef>s2</bpmn:flowNodeRef><bpmn:flowNodeRef>s3</bpmn:flowNodeRef><bpmn:flowNodeRef>s4</bpmn:flowNodeRef><bpmn:flowNodeRef>bs4</bpmn:flowNodeRef><bpmn:flowNodeRef>s5</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_ASIS_02_Validacao_Identificacao_U" name="Autor do avistamento"><bpmn:flowNodeRef>ug1</bpmn:flowNodeRef><bpmn:flowNodeRef>uend</bpmn:flowNodeRef><bpmn:flowNodeRef>ug2</bpmn:flowNodeRef><bpmn:flowNodeRef>u3</bpmn:flowNodeRef><bpmn:flowNodeRef>u2</bpmn:flowNodeRef><bpmn:flowNodeRef>uend2</bpmn:flowNodeRef><bpmn:flowNodeRef>u4</bpmn:flowNodeRef><bpmn:flowNodeRef>u5</bpmn:flowNodeRef><bpmn:flowNodeRef>uend3</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_ASIS_02_Validacao_Identificacao_D" name="Equipe de desenvolvimento"><bpmn:flowNodeRef>ds</bpmn:flowNodeRef><bpmn:flowNodeRef>d1</bpmn:flowNodeRef><bpmn:flowNodeRef>d2</bpmn:flowNodeRef><bpmn:flowNodeRef>d3</bpmn:flowNodeRef><bpmn:flowNodeRef>d4</bpmn:flowNodeRef><bpmn:flowNodeRef>dg</bpmn:flowNodeRef><bpmn:flowNodeRef>d5</bpmn:flowNodeRef><bpmn:flowNodeRef>d6</bpmn:flowNodeRef><bpmn:flowNodeRef>dg2</bpmn:flowNodeRef><bpmn:flowNodeRef>dend</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Abre o feed (sem aviso de pendências)"><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="e1" name="Atualizar e rolar o feed"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_0</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_1</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="e2" name="Analisar foto, espécie e selo da postagem"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_1</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_2</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="eg" name="Identificação correta?"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_2</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_3</bpmn:outgoing><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="eend" name="Segue navegando (análise não registrada)"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_3</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="e3" name="Abrir comentários e escrever a espécie correta"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_4</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="e4" name="Tocar &quot;Enviar&quot;"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_5</bpmn:incoming><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_9</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="s1" name="Gravar o comentário"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_6</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:boundaryEvent id="bs1" name="Falha no envio" attachedToRef="s1"><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_8</bpmn:outgoing><bpmn:errorEventDefinition/></bpmn:boundaryEvent>
    <bpmn:serviceTask id="s2" name="Exibir erro e manter o texto no campo"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_8</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="s3" name="Exibir o comentário na postagem (autor não é notificado)"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_7</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ug1" name="Autor abre a postagem e vê o comentário?"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_10</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_11</bpmn:outgoing><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="uend" name="Identificação errada permanece no feed e no mapa"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_11</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="ug2" name="Concorda com a correção?"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_12</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_13</bpmn:outgoing><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="u3" name="Excluir a postagem e confirmar o aviso"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_13</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_16</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="u2" name="Manter a postagem (pode responder ou excluir o comentário)"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_14</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_15</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="uend2" name="Identificação original mantida"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_15</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="s4" name="Excluir a postagem com fotos, curtidas e comentários"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_16</bpmn:incoming><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_19</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_20</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:boundaryEvent id="bs4" name="Falha na exclusão" attachedToRef="s4"><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_17</bpmn:outgoing><bpmn:errorEventDefinition/></bpmn:boundaryEvent>
    <bpmn:serviceTask id="s5" name="Exibir &quot;Não foi possível excluir&quot;"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_17</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_18</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="u4" name="Tocar para excluir novamente"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_18</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_19</bpmn:outgoing></bpmn:userTask>
    <bpmn:callActivity id="u5" name="Registrar o avistamento de novo (AS-IS 01)"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_20</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_21</bpmn:outgoing></bpmn:callActivity>
    <bpmn:endEvent id="uend3" name="Nova postagem, sem as curtidas e os comentários anteriores"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_21</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="ds" name="Sem periodicidade definida"><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_22</bpmn:outgoing><bpmn:timerEventDefinition/></bpmn:startEvent>
    <bpmn:manualTask id="d1" name="Acessar o banco MySQL de produção"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_22</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_23</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="d2" name="Listar as espécies com status NE"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_23</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_24</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="d3" name="Pesquisar nome popular e status na IUCN/MMA"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_24</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_25</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="d4" name="Executar o UPDATE via SQL"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_25</bpmn:incoming><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_28</bpmn:incoming><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_32</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_26</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="dg" name="Comando executado sem erro?"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_26</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_27</bpmn:outgoing><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_29</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="d5" name="Corrigir o comando SQL"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_27</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_28</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="d6" name="Conferir a espécie no aplicativo"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_29</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_30</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="dg2" name="Dados corretos no app?"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_30</bpmn:incoming><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_31</bpmn:outgoing><bpmn:outgoing>Flow_ASIS_02_Validacao_Identificacao_32</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="dend" name="Catálogo parcialmente curado"><bpmn:incoming>Flow_ASIS_02_Validacao_Identificacao_31</bpmn:incoming></bpmn:endEvent>
