  <bpmn:collaboration id="Collab_TOBE_01C_Publicacao"><bpmn:participant id="Pool_TOBE_01C_Publicacao" name="Extinction — Registrar avistamento (TO-BE) — Parte C: publicação" processRef="Process_TOBE_01C_Publicacao"/></bpmn:collaboration>
  <bpmn:process id="Process_TOBE_01C_Publicacao" name="TO-BE 01.C — Publicar o avistamento" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TOBE_01C_Publicacao">
      <bpmn:lane id="Lane_TOBE_01C_Publicacao_U" name="Usuário (cidadão)"><bpmn:flowNodeRef>lk</bpmn:flowNodeRef><bpmn:flowNodeRef>u1</bpmn:flowNodeRef><bpmn:flowNodeRef>u2</bpmn:flowNodeRef><bpmn:flowNodeRef>u3</bpmn:flowNodeRef><bpmn:flowNodeRef>ug3</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_TOBE_01C_Publicacao_A" name="Aplicativo Extinction"><bpmn:flowNodeRef>ag1</bpmn:flowNodeRef><bpmn:flowNodeRef>a1</bpmn:flowNodeRef><bpmn:flowNodeRef>a2</bpmn:flowNodeRef><bpmn:flowNodeRef>ag2</bpmn:flowNodeRef><bpmn:flowNodeRef>a3</bpmn:flowNodeRef><bpmn:flowNodeRef>be</bpmn:flowNodeRef><bpmn:flowNodeRef>sp</bpmn:flowNodeRef><bpmn:flowNodeRef>a4</bpmn:flowNodeRef><bpmn:flowNodeRef>a5</bpmn:flowNodeRef><bpmn:flowNodeRef>e</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_TOBE_01C_Publicacao_B" name="Backend (API)"><bpmn:flowNodeRef>b1</bpmn:flowNodeRef><bpmn:flowNodeRef>bg</bpmn:flowNodeRef><bpmn:flowNodeRef>bx</bpmn:flowNodeRef><bpmn:flowNodeRef>b3</bpmn:flowNodeRef><bpmn:flowNodeRef>b5</bpmn:flowNodeRef><bpmn:flowNodeRef>bgeo</bpmn:flowNodeRef><bpmn:flowNodeRef>b6</bpmn:flowNodeRef><bpmn:flowNodeRef>b7</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="lk" name="Vindo de 01.B"><bpmn:outgoing>Flow_TOBE_01C_Publicacao_0</bpmn:outgoing><bpmn:linkEventDefinition name="Vindo de 01.B"/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="u1" name="Tocar &quot;Publicar avistamento&quot;"><bpmn:incoming>Flow_TOBE_01C_Publicacao_0</bpmn:incoming><bpmn:incoming>Flow_TOBE_01C_Publicacao_3</bpmn:incoming><bpmn:incoming>Flow_TOBE_01C_Publicacao_14</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_1</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ag1" name="Há foto e espécie, sugestão ou identificação pendente?"><bpmn:incoming>Flow_TOBE_01C_Publicacao_1</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_2</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01C_Publicacao_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a1" name="Destacar o dado que falta"><bpmn:incoming>Flow_TOBE_01C_Publicacao_2</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="a2" name="Gerar o identificador único (UUID) do registro"><bpmn:incoming>Flow_TOBE_01C_Publicacao_4</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ag2" name="Há conexão?"><bpmn:incoming>Flow_TOBE_01C_Publicacao_5</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_6</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01C_Publicacao_7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a3" name="Enviar o registro com o UUID"><bpmn:incoming>Flow_TOBE_01C_Publicacao_6</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:boundaryEvent id="be" name="Falha no envio" attachedToRef="a3"><bpmn:outgoing>Flow_TOBE_01C_Publicacao_8</bpmn:outgoing><bpmn:errorEventDefinition/></bpmn:boundaryEvent>
    <bpmn:subProcess id="sp" name="Guardar na fila local e sincronizar (01.1)"><bpmn:incoming>Flow_TOBE_01C_Publicacao_7</bpmn:incoming><bpmn:incoming>Flow_TOBE_01C_Publicacao_8</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_10</bpmn:outgoing></bpmn:subProcess>
    <bpmn:serviceTask id="b1" name="Verificar UUID (sem duplicar) e validar os dados"><bpmn:incoming>Flow_TOBE_01C_Publicacao_9</bpmn:incoming><bpmn:incoming>Flow_TOBE_01C_Publicacao_10</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="bg" name="Dados válidos?"><bpmn:incoming>Flow_TOBE_01C_Publicacao_11</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_12</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01C_Publicacao_15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a4" name="Notificar o autor e destacar o que corrigir"><bpmn:incoming>Flow_TOBE_01C_Publicacao_12</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="u2" name="Corrigir o registro"><bpmn:incoming>Flow_TOBE_01C_Publicacao_13</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_14</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="bx" name="Situação da espécie?"><bpmn:incoming>Flow_TOBE_01C_Publicacao_15</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_16</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01C_Publicacao_17</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01C_Publicacao_18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="b3" name="Identificar com o BioCLIP e notificar o autor"><bpmn:incoming>Flow_TOBE_01C_Publicacao_18</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="u3" name="Abrir a notificação e ver as candidatas"><bpmn:incoming>Flow_TOBE_01C_Publicacao_19</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_20</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ug3" name="Confirmou uma candidata?"><bpmn:incoming>Flow_TOBE_01C_Publicacao_20</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_21</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01C_Publicacao_22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="b5" name="Marcar &quot;pendente de curadoria&quot; e enviar à fila (TO-BE 02)"><bpmn:incoming>Flow_TOBE_01C_Publicacao_17</bpmn:incoming><bpmn:incoming>Flow_TOBE_01C_Publicacao_22</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_23</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="bgeo" name="Espécie ameaçada (CR/EN/VU) e com localização?"><bpmn:incoming>Flow_TOBE_01C_Publicacao_16</bpmn:incoming><bpmn:incoming>Flow_TOBE_01C_Publicacao_21</bpmn:incoming><bpmn:incoming>Flow_TOBE_01C_Publicacao_23</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_24</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_01C_Publicacao_25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="b6" name="Generalizar a coordenada pública (~10 km)"><bpmn:incoming>Flow_TOBE_01C_Publicacao_24</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_26</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="b7" name="Gravar e publicar no feed e no mapa (se houver local)"><bpmn:incoming>Flow_TOBE_01C_Publicacao_25</bpmn:incoming><bpmn:incoming>Flow_TOBE_01C_Publicacao_26</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_27</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="a5" name="Remover da fila (se veio dela) e exibir &quot;Publicado!&quot;"><bpmn:incoming>Flow_TOBE_01C_Publicacao_27</bpmn:incoming><bpmn:outgoing>Flow_TOBE_01C_Publicacao_28</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Avistamento publicado"><bpmn:incoming>Flow_TOBE_01C_Publicacao_28</bpmn:incoming></bpmn:endEvent>
