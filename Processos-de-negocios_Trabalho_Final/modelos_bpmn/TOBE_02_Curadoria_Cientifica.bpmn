    <bpmn:exclusiveGateway id="d_g2" name="Enviou fotos em 7 dias?"><bpmn:incoming>Flow_TOBE_02_Curadoria_Cientifica_9</bpmn:incoming><bpmn:outgoing>Flow_TOBE_02_Curadoria_Cientifica_10</bpmn:outgoing><bpmn:outgoing>Flow_TOBE_02_Curadoria_Cientifica_11</bpmn:outgoing></bpmn:exclusiveGateway>
